# ESP32-C6FH8, 8 MB flash, single-core FreeRTOS.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=1000

# Fixed NVS/PHY/factory layout; remaining flash is intentionally unpartitioned.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# One NimBLE host owns the Nintendo and PlayGate peripheral roles.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_LE_CONN_RESERVED_MEMORY_COUNT=2
CONFIG_BT_LE_EXT_ADV_RESERVED_MEMORY_COUNT=2

# Verified controller/host mbuf baseline for the 5 ms console link.
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=30
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=150
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=128
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=30
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=512

# Wi-Fi software coexistence remains enabled; UDP startup disables Wi-Fi PS.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Keep framed USB Serial/JTAG free of application console and log output.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

CONFIG_PLAYGATE_ENABLE_SERIAL=y
CONFIG_PLAYGATE_SERIAL_USB_SERIAL_JTAG=y
CONFIG_PLAYGATE_ENABLE_UDP=y
CONFIG_PLAYGATE_INPUT_TIMEOUT_MS=100
CONFIG_PLAYGATE_SOURCE_LEASE_MS=300
CONFIG_PLAYGATE_UDP_PORT=26760
CONFIG_PLAYGATE_WIFI_SSID=""
CONFIG_PLAYGATE_WIFI_PASSWORD=""
CONFIG_PLAYGATE_REPORT_HZ=100

# Wi-Fi web control page: WebSocket support is off by default in esp_http_server.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_PLAYGATE_ENABLE_WEB=y
CONFIG_PLAYGATE_AP_SSID_PREFIX="PlayGate"
CONFIG_PLAYGATE_AP_PASSWORD="playgate"
